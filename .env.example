# ================================================================
# ملف بيئة المشروع الموحد
# ----------------------------------------------------------------
# للتطوير المحلي: انسخ هذا الملف إلى .env وعدّل القيم
#
# على فرسيل: أضف هذه المتغيرات في إعدادات المشروع:
#   Project Settings → Environment Variables
# ================================================================

# ----------------------------------------------------------------
# قاعدة البيانات (سوبابيس بوستجرس)
# ----------------------------------------------------------------
# رابط الاستخدام اليومي (مع pgbouncer للأداء)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# رابط مباشر للترحيلات (بدون pgbouncer)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ----------------------------------------------------------------
# المصادقة
# ----------------------------------------------------------------
# مفتاح سري طويل عشوائي لتوقيع الرموز
# مثال: استخدم openssl rand -base64 32 لتوليده
JWT_SECRET="change_this_to_a_long_random_string_min_32_chars"

# ----------------------------------------------------------------
# المهام المجدولة (الكرون)
# ----------------------------------------------------------------
# سر يحمي مسار /api/cron/run من الاستدعاء المباشر
# فرسيل يضبطه تلقائياً في الإنتاج
CRON_SECRET="change_this_to_a_cron_secret"

# ----------------------------------------------------------------
# البريد الإلكتروني — Microsoft 365 عبر Microsoft Graph (مُفضَّل)
# ----------------------------------------------------------------
# عند ضبط هذه المتغيرات يُرسَل كل بريد المنصة عبر M365 ويُتجاهل Resend.
# تطبيق مسجّل في Entra ID بصلاحية Mail.Send (Application) + Grant admin consent،
# ويُفضَّل تقييده بصندوق المُرسِل وحده (Application Access Policy).
MS_GRAPH_TENANT_ID=""
MS_GRAPH_CLIENT_ID=""
MS_GRAPH_CLIENT_SECRET=""
MS_GRAPH_SENDER="od@nauss.edu.sa"

# ----------------------------------------------------------------
# البريد الإلكتروني — Resend (https://resend.com)
# ----------------------------------------------------------------
# ١. أنشئ حساباً مجانياً في resend.com
# ٢. من لوحة التحكم: API Keys → Create API Key
# ٣. انسخ المفتاح هنا
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# البريد المُرسِل
# للتطوير: يمكن استخدام onboarding@resend.dev مباشرة بدون إعداد
# للإنتاج: أضف نطاقك في Resend → Domains → Add Domain
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# ----------------------------------------------------------------
# التحقق الثنائي عبر البريد (OTP) عند تسجيل الدخول
# ----------------------------------------------------------------
# يُدار من الملف الشخصي للمدير (auth.mfa.enabled / auth.mfa.from في AppSetting).
# مخرج طوارئ: MFA_ENABLED=false يعطّله قسراً إن تعطّل إرسال البريد.
# MFA_ENABLED=false
# المُرسِل الاحتياطي إن لم يُضبط في الإعدادات — يجب توثيق نطاقه في Resend
MFA_FROM_EMAIL="od@nauss.edu.sa"

# رابط الموقع الأساسي (يُستخدم في روابط الرسائل)
NEXT_PUBLIC_SITE_URL="https://end-nif.vercel.app"

# ----------------------------------------------------------------
# البداية الرسمية لاحتساب مؤشرات الأداء
# ----------------------------------------------------------------
OFFICIAL_KPI_START="2026-06"

# ----------------------------------------------------------------
# Webhook — ربط موقع السلف والتسويات
# ----------------------------------------------------------------
# سر مشترك بين هذه المنصة وموقع السلف
# أنشئه عشوائياً: openssl rand -base64 32
WEBHOOK_SECRET="change_this_to_a_strong_random_secret"

# عنوان منصة السلف التي يفتحها زر «منصة السلف» داخل الدورة،
# وهو نفسه الذي يرسل إشعارات الإقفال إلى /api/webhooks/solf-closure-sync
# المنصة الحالية على خادم الجامعة (القديمة على Vercel لم تعد المعتمدة)
NEXT_PUBLIC_SOLF_URL="https://solf-training.nauss.edu.sa"

# ----------------------------------------------------------------
# المصادقة عبر Active Directory (LDAP) — اختياري
# ----------------------------------------------------------------
# عند عدم ضبط LDAP_URL / LDAP_BIND_DN / LDAP_BIND_PASSWORD تُتخطّى مصادقة
# الدليل تماماً، ويعمل مسار كلمة المرور المحلية فقط (انظر lib/ldap/auth.js
# — isLdapConfigured). لا يُنشئ الدخول عبر AD حساباً جديداً؛ يجب أن يكون
# المستخدم مضافاً مسبقاً في لوحة إدارة المستخدمين وبنفس بريد الدليل.
LDAP_URL="ldaps://dc01.nauss1.edu.sa"
LDAP_BIND_DN="CN=svc-end,OU=Service Accounts,DC=nauss1,DC=edu,DC=sa"
LDAP_BIND_PASSWORD=""
LDAP_BASE_DN="DC=nauss1,DC=edu,DC=sa"
# شهادة الجذر الداخلية المطلوبة لـ ldaps://. يقرأها Node مباشرة، وليس كود التطبيق.
NODE_EXTRA_CA_CERTS="/etc/ssl/certs/nauss-root-ca.pem"

# ----------------------------------------------------------------
# بيئة التشغيل
# ----------------------------------------------------------------
NODE_ENV=development
