# ================================================================
# ملف بيئة المشروع الموحد
# ----------------------------------------------------------------
# للتطوير المحلي: انسخ هذا الملف إلى .env وعدّل القيم
#
# على فرسيل: أضف هذه المتغيرات في إعدادات المشروع:
#   Project Settings → Environment Variables
# ================================================================

# ----------------------------------------------------------------
# قاعدة البيانات (سوبابيس بوستجرس)
# ----------------------------------------------------------------
# رابط الاستخدام اليومي (مع pgbouncer للأداء)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# رابط مباشر للترحيلات (بدون pgbouncer)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ----------------------------------------------------------------
# المصادقة
# ----------------------------------------------------------------
# مفتاح سري طويل عشوائي لتوقيع الرموز
# مثال: استخدم openssl rand -base64 32 لتوليده
JWT_SECRET="change_this_to_a_long_random_string_min_32_chars"

# ----------------------------------------------------------------
# المهام المجدولة (الكرون)
# ----------------------------------------------------------------
# سر يحمي مسار /api/cron/run من الاستدعاء المباشر
# فرسيل يضبطه تلقائياً في الإنتاج
CRON_SECRET="change_this_to_a_cron_secret"

# ----------------------------------------------------------------
# البريد الإلكتروني — Resend (https://resend.com)
# ----------------------------------------------------------------
# ١. أنشئ حساباً مجانياً في resend.com
# ٢. من لوحة التحكم: API Keys → Create API Key
# ٣. انسخ المفتاح هنا
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# البريد المُرسِل
# للتطوير: يمكن استخدام onboarding@resend.dev مباشرة بدون إعداد
# للإنتاج: أضف نطاقك في Resend → Domains → Add Domain
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# رابط الموقع الأساسي (يُستخدم في روابط الرسائل)
NEXT_PUBLIC_SITE_URL="https://end-nif.vercel.app"

# ----------------------------------------------------------------
# البداية الرسمية لاحتساب مؤشرات الأداء
# ----------------------------------------------------------------
OFFICIAL_KPI_START="2026-06"

# ----------------------------------------------------------------
# بيئة التشغيل
# ----------------------------------------------------------------
NODE_ENV=development
