generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  EMPLOYEE
  PROJECT_SUPERVISOR
  MANAGER
  QUALITY_VIEWER
}

enum ElementStatus {
  NOT_STARTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  NOT_APPLICABLE
  RETURNED
}

enum CourseStatus {
  PREPARATION
  EXECUTION
  AWAITING_CLOSURE
  CLOSED
  ARCHIVED
}

enum KpiPeriodType {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum PerformanceLevel {
  OUTSTANDING
  VERY_GOOD
  GOOD
  NEEDS_IMPROVEMENT
  WEAK
}

enum BadgeType {
  COMMITTED        // ملتزم: كل العناصر قبل الموعد المثالي
  PRECISE          // دقيق: صفر إعادات في فترة كاملة
  FAST             // سريع: أسرع متوسط تقديم في الفريق
  IMPROVER         // متحسن: أفضل تحسن في الاتجاه
  CONSISTENT       // ثابت: 3 أشهر متتالية فوق 80%
  PIONEER          // رائد: أول من يكمل كل العناصر لدورة
  IDEA_CHAMPION    // مبدع: مبادرة معتمدة ومنفذة
  TEAM_PLAYER      // فريق: تحدي فريق محقق
  PLEDGE_KEEPER    // وفي: تحقيق التعهد الشخصي
  STAR             // نجم: أداء متميز مرتين متتاليتين
}

enum IdeaStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  IMPLEMENTED
  REJECTED
}

enum ChallengeStatus {
  ACTIVE
  ACHIEVED
  FAILED
  CANCELLED
}

// =============================================================
// بلاغات العوائق — سبب التأخر المُعلن مسبقاً
// -------------------------------------------------------------
// يرفع المنسق البلاغ وهو منتظر، فتتوقف ساعة العنصر من لحظة
// الرفع لا من تاريخ يكتبه بيده. والبلاغ المرفوع بعد فوات
// الموعد لا يؤجّله — وبهذا يُسدّ باب الادّعاء بأثر رجعي.
// =============================================================
enum BlockerReason {
  TRAINER_GRADES       // تأخر تسجيل الدرجات من المدرب
  TRAINEE_NAMES        // تأخر استلام أسماء المتدربين
  INSURANCE_SUSPENDED  // إيقاف إصدار التأمين الطبي
  FINANCE_PENDING      // بانتظار إجراء مالي
  BENEFICIARY_PENDING  // بانتظار الجهة المستفيدة
  OTHER
}

enum BlockerStatus {
  OPEN       // العائق قائم والساعة متوقفة
  RESOLVED   // انتهى العائق وعادت الساعة
  CANCELLED  // سحبه المنسق — لا يُحتسب
}

enum BlockerCredit {
  AUTO_APPROVED           // تحت السقف الفصلي — يسري تلقائياً
  QUOTA_EXCEEDED_PENDING  // تجاوز السقف — بانتظار قرار المدير
  MANAGER_APPROVED        // اعتمده المدير بعد تجاوز السقف
  MANAGER_REJECTED        // رفضه المدير — العقوبة قائمة
}

enum LateEntryStatus {
  PENDING   // بانتظار نظر المدير
  ACCEPTED  // مبرر مقبول — لا ملاحظة على المنسق
  REJECTED  // مبرر مرفوض — تُسجّل نقطة والدورة تبقى
}

model OperationalProject {
  id           String   @id @default(uuid())
  name         String   @unique
  createdAt    DateTime @default(now())
  users        User[]
  courses      Course[]
  supervisors  ProjectSupervisor[]
  // لقطات الأداء المنسوبة لهذا المشروع لحظة التقاطها (تاريخ ثابت لا يتغيّر بنقل المنسقين)
  kpiSnapshots EmployeeKpiSnapshot[] @relation("KpiSnapshotProject")
}

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  // فارغ لحسابات مصادَقة عبر Active Directory حصراً (بلا كلمة مرور محلية)
  passwordHash         String?
  firstName            String
  lastName             String
  mobileNumber         String
  extensionNumber      String?
  profileImage         String?
  signatureImage       String?
  roles                Role[]
  isActive             Boolean  @default(true)
  // فارغ للمنسق المتعاون: لا ينتمي لمشروع، ومرجعه المدير
  operationalProjectId String?
  operationalProject   OperationalProject? @relation(fields: [operationalProjectId], references: [id])
  // منسق متعاون من خارج موظفي العمليات — يتابعه مشرف يسنده المدير
  isCollaborator       Boolean  @default(false)
  followUpSupervisorId String?
  followUpSupervisor   User?    @relation("FollowUpSupervisor", fields: [followUpSupervisorId], references: [id], onDelete: SetNull)
  followedCollaborators User[]  @relation("FollowUpSupervisor")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  termsAccepted        Boolean  @default(false)
  termsAcceptedAt      DateTime?
  resetToken           String?
  resetTokenExpiry     DateTime?
  tokenVersion         Int      @default(0)
  // التحقق الثنائي عبر البريد — رمز OTP مُجزّأ + انتهاء + محاولات خاطئة
  otpHash              String?
  otpExpiry            DateTime?
  otpAttempts          Int      @default(0)

  primaryCourses       Course[]                @relation("PrimaryResponsible")
  supportingCourses    CourseSupport[]         @relation("SupportingMember")
  auditLogs            AuditLog[]
  notifications        Notification[]
  executedElements     CourseClosureTracking[] @relation("Executor")
  decidedElements      CourseClosureTracking[] @relation("Decider")

  sentMessages         Message[]               @relation("MessageSender")
  receivedMessages     MessageRecipient[]      @relation("MessageRecipientUser")
  readMessages         MessageRecipient[]      @relation("MessageReadBy")

  kpiSnapshots         EmployeeKpiSnapshot[]   @relation("KpiSnapshotUser")
  kpiNotes             EmployeeKpiNote[]       @relation("KpiNoteUser")
  managerKpiNotes      EmployeeKpiNote[]       @relation("KpiNoteManager")

  courseAssignments    CourseAssignmentRegister[] @relation("AssignmentUser")
  grantedExtensions    CourseClosureTracking[]    @relation("ExtensionGranter")
  overriddenElements   CourseClosureTracking[]    @relation("ElementOverrider")
  createdClosureElements ClosureElement[]         @relation("ClosureElementCreator")
  optionalReports      CourseOptionalReport[]     @relation("OptionalReportAuthor")
  fieldReports         FieldReport[]              @relation("FieldReportAuthor")
  fieldReportComments  FieldReportComment[]       @relation("FieldReportCommentAuthor")
  closureReviews       ClosureReview[]            @relation("ClosureReviewAuthor")

  // ----- علاقة الإشراف على مشاريع تشغيلية -----
  supervisedProjects   ProjectSupervisor[]        @relation("SupervisorUser")

  // ----- الأدوات التحفيزية -----
  badges               EmployeeBadge[]            @relation("BadgeUser")
  awardedBadges        EmployeeBadge[]            @relation("BadgeAwarder")
  ideas                ImprovementIdea[]          @relation("IdeaAuthor")
  reviewedIdeas        ImprovementIdea[]          @relation("IdeaReviewer")
  ideaSupports         IdeaSupport[]              @relation("IdeaSupportUser")
  pledges              MonthlyPledge[]            @relation("PledgeUser")

  // ----- بلاغات العوائق وفترات الإيقاف والإدخال المتأخر -----
  raisedBlockers       ElementBlocker[]           @relation("BlockerRaiser")
  decidedBlockers      ElementBlocker[]           @relation("BlockerDecider")
  createdSuspensions   ElementSuspension[]        @relation("SuspensionCreator")
  lateEntryDecisions   Course[]                   @relation("LateEntryDecider")
  interpreterRecords   CourseInterpreter[]        @relation("InterpreterDataAuthor")
  interpretersAdded    Interpreter[]              @relation("InterpreterDirectoryAuthor")

  @@index([followUpSupervisorId])
}

// =============================================================
// بيانات مترجم الدورة
// -------------------------------------------------------------
// تُعبَّأ مرة واحدة لكل دورة، وتخدم مخرجات المترجم الأربعة:
// العقد، وطلب الصرف بالتحويل، ونموذج الاستحقاق بالسلفة، وشهادة
// إنجاز الترجمة — فلا يُعاد إدخال الاسم والهوية في كل مستند.
// بيانات الطرف الأول (الجامعة) ثابتة في قالب المستند لا هنا.
// =============================================================
model CourseInterpreter {
  id          String   @id @default(uuid())
  courseId    String   @unique
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  fullName    String
  nationalId  String
  email       String
  mobile      String
  address     String
  // الجنسية — تُذكر في صدر العقد
  nationality String?
  // قيمة المستحق — يحتاجها طلب الصرف ونموذج الاستحقاق
  amount      Float?
  // الحساب البنكي — جدول الدفع في العقد ونموذج الاستحقاق المالي
  bankName    String?
  bankBranch  String?
  bankCountry String?
  iban        String?
  notes       String?

  createdById String?
  createdBy   User?    @relation("InterpreterDataAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // المترجم في السجل الذي اختير منه — والبيانات أعلاه نسخة الدورة منه،
  // فتعديل السجل لاحقاً لا يغيّر عقداً وُقّع
  interpreterId String?
  interpreter   Interpreter? @relation(fields: [interpreterId], references: [id], onDelete: SetNull)

  @@index([interpreterId])
}

// سجل المترجمين — قاعدة واحدة يختار منها المنسق بدل إعادة إدخال
// البيانات في كل دورة. يديره المدير، ويُضاف إليه تلقائياً كل مترجم
// جديد يسجّله منسق. البيانات الثابتة وحدها (الشخصية والبنكية)؛
// أما المتغيّر مع كل تعاقد (المبلغ، المدة، البرنامج) فمكانه الدورة.
model Interpreter {
  id          String   @id @default(uuid())
  fullName    String
  nationalId  String   @unique
  nationality String?
  email       String
  mobile      String
  address     String
  specialty   String?
  bankName    String?
  bankBranch  String?
  bankCountry String?
  iban        String?
  notes       String?

  createdById String?
  createdBy   User?    @relation("InterpreterDirectoryAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses     CourseInterpreter[]

  @@index([fullName])
}

// =============================================================
// جدول الإشراف على المشاريع التشغيلية
// -------------------------------------------------------------
// يربط مستخدماً يحمل دور PROJECT_SUPERVISOR بمشروع تشغيلي واحد
// القاعدة: كل مشرف لمشروع واحد فقط (فرض عبر الفهرس الفريد على userId)
// =============================================================
model ProjectSupervisor {
  id                   String   @id @default(uuid())
  userId               String
  operationalProjectId String
  createdAt            DateTime @default(now())
  createdById          String?  // المدير الذي أسند

  user                 User               @relation("SupervisorUser", fields: [userId], references: [id], onDelete: Cascade)
  operationalProject   OperationalProject @relation(fields: [operationalProjectId], references: [id], onDelete: Cascade)

  // مشرف واحد لكل مستخدم (لا يمكن أن يشرف على أكثر من مشروع)
  @@unique([userId])
  @@index([operationalProjectId])
}

model Course {
  id                             String       @id @default(uuid())
  name                           String
  code                           String?
  beneficiaryEntity              String?
  city                           String
  locationType                   String
  startDate                      DateTime
  endDate                        DateTime
  numTrainees                    Int
  courseType                     String
  requiresAdvance                Boolean      @default(false)
  requiresRevenue                Boolean      @default(false)
  materialsIssued                Boolean      @default(false)
  requiresAdvanceSettlement      Boolean      @default(false)
  requiresSupervisorCompensation Boolean      @default(false)
  requiresTrainerCompensation    Boolean      @default(false)
  requiresPreTest                Boolean      @default(false)
  requiresPostTest               Boolean      @default(false)
  isCrossProject                 Boolean      @default(false)
  // التقارير — مشروطة (خارجية = إجبارية، داخلية = اختيارية)
  requiresOpeningReport          Boolean      @default(false)
  requiresClosingReport          Boolean      @default(false)
  // الموظف فعّل التقرير بنفسه تطوّعاً (وليس لكونه إجبارياً) — يُستخدم لمنح تقدير في المؤشرات
  openingReportVoluntary         Boolean      @default(false)
  closingReportVoluntary         Boolean      @default(false)

  // ----- مترجم الدورة -----
  // اختياري: المنسق يحدده عند إضافة الدورة. ونوع التعاقد يحدد العنصر
  // المطلوب منه: عقد، أو طلب صرف بتحويل، أو نموذج استحقاق بسلفة.
  requiresInterpreter            Boolean      @default(false)
  interpreterContractType        String?      // CONTRACT | TRANSFER | ADVANCE
  status                         CourseStatus @default(PREPARATION)

  operationalProjectId           String
  operationalProject             OperationalProject @relation(fields: [operationalProjectId], references: [id])

  primaryEmployeeId              String
  primaryEmployee                User @relation("PrimaryResponsible", fields: [primaryEmployeeId], references: [id])

  supportingTeam                 CourseSupport[]
  closureElements                CourseClosureTracking[]
  optionalReports                CourseOptionalReport[]
  fieldReports                   FieldReport[]
  auditLogs                      AuditLog[]
  messages                       Message[]
  blockers                       ElementBlocker[]
  interpreter                    CourseInterpreter?
  // توثيق الدورة — عنصر تميّز اختياري (لا يدخل في الإقفال ولا يُخصم بغيابه)
  documentation                  CourseDocumentation?
  // تقييم صعوبات الإقفال — يقيّم به المنسق الإدارات الأخرى بعد إقفال الدورة
  closureReview                  ClosureReview?

  // ----- الإدخال المتأخر للدورة -----
  // المنصة تكتشف التأخير بنفسها (مقارنة لحظة الإدخال بتواريخ الدورة)
  // فلا يستطيع المنسق الكذب فيه. والمبرر وحده هو ما ينظر فيه المدير.
  isLateEntry                    Boolean          @default(false)
  lateEntryHours                 Int?             // مقدار التأخير بالساعات — للتدريج
  lateEntryReason                String?          // مبرر المنسق (إلزامي عند التأخر)
  lateEntryStatus                LateEntryStatus?
  lateEntryDecidedById           String?
  lateEntryDecidedBy             User?            @relation("LateEntryDecider", fields: [lateEntryDecidedById], references: [id], onDelete: SetNull)
  lateEntryDecidedAt             DateTime?
  lateEntryDecisionNote          String?
  // لحظة إدخال الدورة — مرجع استثناء العناصر التي فات موعدها قبلها
  entryBaselineAt                DateTime?

  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
  // لحظة الإقفال الفعلي (تُضبط عند الانتقال إلى CLOSED) — مرجع دقيق لحساب تأخر الإقفال
  closedAt                       DateTime?

  @@index([operationalProjectId])
  @@index([primaryEmployeeId])
  @@index([status])
  @@index([isLateEntry, lateEntryStatus])
}

// تقارير اختيارية — متعددة لكل دورة, لا تؤثر على KPI سلباً
model CourseOptionalReport {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("OptionalReportAuthor", fields: [authorId], references: [id])
  title     String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

model CourseSupport {
  id       String @id @default(uuid())
  courseId String
  userId   String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user     User   @relation("SupportingMember", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
}

// =============================================================
// تقارير الملاحظات الميدانية — سجل أرشيفي (مفتوح، غير قابل للتعديل بعد الإرسال)
// =============================================================
model FieldReport {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("FieldReportAuthor", fields: [authorId], references: [id])
  formData  Json
  createdAt DateTime @default(now())
  comments  FieldReportComment[]

  @@index([courseId])
  @@index([authorId])
}

// تعليقات الزملاء على التقرير الميداني — ليُتلافى ما لوحظ في الدورات القادمة
model FieldReportComment {
  id        String      @id @default(uuid())
  reportId  String
  report    FieldReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  authorId  String
  author    User        @relation("FieldReportCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime    @default(now())

  @@index([reportId, createdAt])
}

// تقييم صعوبات الإقفال: بعد إقفال الدورة يسجّل المنسق ما واجهه من الإدارات
// الأخرى (تأخر أسماء المتدربين، معلومات المدربين…)، فيُبنى منه مؤشر أداء الإدارات.
model ClosureReview {
  id        String            @id @default(uuid())
  courseId  String            @unique
  course    Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?             @relation("ClosureReviewAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  noIssues  Boolean           @default(false)
  note      String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  issues    DepartmentIssue[]

  @@index([createdAt])
}

model DepartmentIssue {
  id         String        @id @default(uuid())
  reviewId   String
  review     ClosureReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  courseId   String
  department String        // مفتاح الإدارة من القائمة (business_dev …)
  issueType  String        // مفتاح نوع الصعوبة داخل الإدارة
  impact     String        @default("MEDIUM") // LOW | MEDIUM | HIGH
  delayDays  Int?
  note       String?
  // كيف تجاوزها المنسق — خبرة تُنقل لزملائه في «مساعد التنفيذ»
  resolution String?
  // موضع الصعوبة إن كانت في مقر التنفيذ (بطء الإنترنت، القاعة…)
  country    String?
  city       String?
  venue      String?
  createdAt  DateTime      @default(now())

  @@index([department, createdAt])
  @@index([courseId])
}

// صعوبات أضافها المنسقون بأنفسهم — تصير خياراً لمن بعدهم في القائمة نفسها
model IssueType {
  id          String   @id @default(uuid())
  department  String
  key         String   @unique // c_xxxxxxxx
  label       String
  usageCount  Int      @default(0)
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([department, label])
}

model ClosureElement {
  id                     String   @id @default(uuid())
  key                    String   @unique
  name                   String
  isFormBased            Boolean  @default(false)
  deadlineRefPoint       String?  // 'START' | 'END'
  deadlineIdealHours     Int?
  deadlineMaxHours       Int?
  isDeadlineWorkingDays  Boolean  @default(false)

  // نوع العنصر وضوابط تطبيقه
  elementType            String   @default("MANDATORY") // MANDATORY | CONDITIONAL | OPTIONAL
  conditionField         String?  // اسم حقل boolean في Course (للنوع CONDITIONAL)، أو "field=value"
  isActive               Boolean  @default(true)
  isCustom               Boolean  @default(false)
  createdById            String?
  createdBy              User?    @relation("ClosureElementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt              DateTime @default(now())

  courseClosureTrackings CourseClosureTracking[]
  suspensions            ElementSuspension[]
}

// =============================================================
// فترات إيقاف عنصر إقفال — قرار مؤسسي بتاريخ
// -------------------------------------------------------------
// مثال: إيقاف إصدار التأمين الطبي من تاريخ كذا إلى إشعار آخر.
// كل دورة تبدأ داخل الفترة يسقط عنها العنصر تلقائياً ولا يُحتسب،
// والدورات المفتوحة حالياً تُحدَّث معها. والمنسق لا يفعل شيئاً —
// فلا نسيان ولا خطأ ولا تلاعب، والسجل يبيّن سبب السقوط بعد سنوات.
// =============================================================
model ElementSuspension {
  id          String   @id @default(uuid())
  elementId   String
  element     ClosureElement @relation(fields: [elementId], references: [id], onDelete: Cascade)

  startsAt    DateTime
  endsAt      DateTime?  // فارغ = إلى إشعار آخر
  reason      String
  isActive    Boolean  @default(true)

  createdById String?
  createdBy   User?    @relation("SuspensionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trackings   CourseClosureTracking[]

  @@index([elementId, isActive])
  @@index([startsAt, endsAt])
}

model CourseClosureTracking {
  id              String @id @default(uuid())
  courseId        String
  elementId       String
  status          ElementStatus @default(NOT_STARTED)

  executionAt     DateTime?
  executedById    String?
  executor        User? @relation("Executor", fields: [executedById], references: [id])

  decisionAt      DateTime?
  decidedById     String?
  decider         User? @relation("Decider", fields: [decidedById], references: [id])

  rejectionReason      String?
  notes                String?
  formData             Json?
  delayReason          String?

  extensionGrantedAt   DateTime?
  extensionGrantedById String?
  extensionGrantedBy   User?     @relation("ExtensionGranter", fields: [extensionGrantedById], references: [id], onDelete: SetNull)
  extensionHours       Int?
  extensionReason      String?

  // استثناءات/استرجاع المدير
  overrideReason       String?
  overriddenAt         DateTime?
  overriddenById       String?
  overriddenBy         User?     @relation("ElementOverrider", fields: [overriddenById], references: [id], onDelete: SetNull)

  // سقوط العنصر بفترة إيقاف مؤسسية (لا بإعفاء يدوي من المدير)
  // نحتفظ بالمرجع لنعيد العنصر وحده عند انتهاء الإيقاف، بلا أن
  // نمسّ ما أعفاه المدير بقراره.
  suspensionId    String?
  suspension      ElementSuspension? @relation(fields: [suspensionId], references: [id], onDelete: SetNull)

  blockers        ElementBlocker[]

  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  element         ClosureElement @relation(fields: [elementId], references: [id])

  @@unique([courseId, elementId])
  @@index([status])
  @@index([executedById])
  @@index([decidedById])
  @@index([elementId])
  @@index([suspensionId])
}

// =============================================================
// بلاغ عائق على عنصر إقفال
// -------------------------------------------------------------
// البلاغ يسري بمجرد رفعه (لا يعتمده أحد) ما دام المنسق تحت
// سقفه الفصلي — فلا يتوقف الإنصاف على اجتهاد مُراجِع. وهو
// منشور ومنسوب لجهة بالاسم، فالحارس عليه هو الجهة المتّهمة
// لا المُراجِع. ومَن تجاوز سقفه وصل إلى مكتب المدير وحده.
// =============================================================
model ElementBlocker {
  id             String        @id @default(uuid())
  trackingId     String
  tracking       CourseClosureTracking @relation(fields: [trackingId], references: [id], onDelete: Cascade)
  // مكرَّر عن قصد: التقارير الأسبوعية والمقارنات تستعلم بالدورة مباشرة
  courseId       String
  course         Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)

  raisedById     String
  raisedBy       User          @relation("BlockerRaiser", fields: [raisedById], references: [id])

  reason         BlockerReason
  awaitedParty   String        // الجهة المنتظَرة بالاسم — "المدرب فلان" / "إدارة تطوير الأعمال"
  details        String

  raisedAt       DateTime      @default(now())
  resolvedAt     DateTime?
  status         BlockerStatus @default(OPEN)

  // ── الاحتساب في المؤشرات ──
  isCredited     Boolean       @default(true)
  credit         BlockerCredit @default(AUTO_APPROVED)
  quarterKey     String        // الفصل الذي يُحتسب منه السقف — مثل 2026-Q4

  decidedById    String?
  decidedBy      User?         @relation("BlockerDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt      DateTime?
  decisionNote   String?

  // آخر مرة أُدرج فيها في القائمة الأسبوعية المُرسلة للجهة المنتظَرة
  lastNotifiedAt DateTime?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([trackingId])
  @@index([courseId])
  @@index([raisedById, quarterKey])
  @@index([status])
  @@index([reason, status])
}

model AuditLog {
  id          String @id @default(uuid())
  courseId    String?
  course      Course? @relation(fields: [courseId], references: [id])
  userId      String?
  user        User?  @relation(fields: [userId], references: [id])
  roleContext String
  action      String
  details     Json?
  createdAt   DateTime @default(now())

  @@index([courseId])
  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Message {
  id          String             @id @default(uuid())
  senderId    String
  subject     String
  body        String
  courseId    String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  sender      User               @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  course      Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  recipients  MessageRecipient[]

  @@index([senderId])
  @@index([courseId])
}

model MessageRecipient {
  id            String    @id @default(uuid())
  messageId     String
  recipientId   String
  isRead        Boolean   @default(false)
  readAt        DateTime?
  readById      String?
  createdAt     DateTime  @default(now())

  message       Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipient     User      @relation("MessageRecipientUser", fields: [recipientId], references: [id], onDelete: Cascade)
  readBy        User?     @relation("MessageReadBy", fields: [readById], references: [id], onDelete: SetNull)

  @@unique([messageId, recipientId])
  @@index([recipientId, isRead])
}

model CourseAssignmentRegister {
  id                    String        @id @default(uuid())
  userId                String
  user                  User          @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Cascade)

  periodType            KpiPeriodType @default(MONTHLY)
  periodLabel           String
  periodStart           DateTime
  periodEnd             DateTime

  assignedCoursesCount  Int           @default(0)
  notes                 String?

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([userId, periodType, periodLabel])
  @@index([periodType, periodStart, periodEnd])
}

model EmployeeKpiSetting {
  id                           String   @id @default(uuid())
  name                         String   @default("Default KPI Settings")
  isActive                     Boolean  @default(true)

  closureCompletionWeight      Float    @default(15)
  overdueClosuresWeight        Float    @default(15)

  avgElementSubmissionWeight   Float    @default(5)
  avgResubmissionWeight        Float    @default(5)
  avgCourseClosureWeight       Float    @default(10)

  firstPassApprovalWeight      Float    @default(15)
  returnRateWeight             Float    @default(10)
  rejectRateWeight             Float    @default(5)
  errorRateWeight              Float    @default(5)

  overdueCoursesWeight         Float    @default(5)
  overdueElementsWeight        Float    @default(5)
  staleElementsWeight          Float    @default(5)

  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  snapshots                    EmployeeKpiSnapshot[]
}

model EmployeeKpiSnapshot {
  id                               String              @id @default(uuid())
  userId                           String
  periodType                       KpiPeriodType
  periodLabel                      String
  periodStart                      DateTime
  periodEnd                        DateTime

  requiredElementsCount            Int                 @default(0)
  completedElementsCount           Int                 @default(0)
  closureCompletionRate            Float               @default(0)

  dueCoursesCount                  Int                 @default(0)
  closedCoursesCount               Int                 @default(0)
  dueCourseClosureRate             Float               @default(0)

  submittedElementsCount           Int                 @default(0)
  approvedElementsCount            Int                 @default(0)
  returnedElementsCount            Int                 @default(0)
  rejectedElementsCount            Int                 @default(0)

  firstPassApprovalRate            Float               @default(0)
  returnRate                       Float               @default(0)
  rejectRate                       Float               @default(0)
  operationalErrorRate             Float               @default(0)

  avgElementSubmissionHours        Float               @default(0)
  avgResubmissionHours             Float               @default(0)
  avgCourseClosureDelayDays        Float               @default(0)

  overdueCoursesCount              Int                 @default(0)
  overdueCoursesRate               Float               @default(0)

  overdueElementsCount             Int                 @default(0)
  overdueElementsRate              Float               @default(0)

  stalePendingElementsCount        Int                 @default(0)
  stalePendingElementsRate         Float               @default(0)

  productivityScore                Float               @default(0)
  timelinessScore                  Float               @default(0)
  qualityScore                     Float               @default(0)
  criticalScore                    Float               @default(0)
  speedScore                       Float               @default(0)
  disciplineScore                  Float               @default(0)
  reportBonusScore                 Float               @default(0)  // مكافأة تقديم التقارير (+0 إلى +5)
  excellenceBonus                  Float               @default(0)  // مكافأة توثيق الدورات المميّز (+٣ لكل دورة، حد +٦)
  finalScore                       Float               @default(0)
  performanceLevel                 PerformanceLevel    @default(GOOD)

  // ----- المشروع التشغيلي لحظة التقاط اللقطة -----
  // يُسجَّل مع اللقطة نفسها، فيبقى أداء الشهر منسوباً للمشروع الذي كان
  // المنسق يعمل فيه فعلاً، ولا يغيّره أي نقل لاحق بين المشاريع.
  operationalProjectId             String?
  operationalProject               OperationalProject? @relation("KpiSnapshotProject", fields: [operationalProjectId], references: [id], onDelete: SetNull)

  settingsId                       String?
  settings                         EmployeeKpiSetting? @relation(fields: [settingsId], references: [id], onDelete: SetNull)

  createdAt                        DateTime            @default(now())
  updatedAt                        DateTime            @updatedAt

  user                             User                @relation("KpiSnapshotUser", fields: [userId], references: [id], onDelete: Cascade)
  notes                            EmployeeKpiNote[]

  @@unique([userId, periodType, periodLabel])
  @@index([periodType, periodStart, periodEnd])
  @@index([finalScore])
  @@index([periodType, periodLabel, operationalProjectId])
}

model EmployeeKpiNote {
  id          String              @id @default(uuid())
  snapshotId  String
  userId      String
  managerId   String
  note        String
  createdAt   DateTime            @default(now())

  snapshot    EmployeeKpiSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  user        User                @relation("KpiNoteUser", fields: [userId], references: [id], onDelete: Cascade)
  manager     User                @relation("KpiNoteManager", fields: [managerId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([userId])
  @@index([managerId])
}
// =============================================================
// نظام المهام المجدولة المرن
// -------------------------------------------------------------
// جدول مهام يُشغّل بواسطة مسار كرون واحد (يستيقظ يومياً)
// يدعم عدداً غير محدود من المهام المجدولة بترددات متنوعة
// =============================================================

enum ScheduledJobType {
  COURSE_DELAY_CHECK      // فحص الدورات المتأخرة في الإقفال
  ELEMENT_STALE_CHECK     // فحص العناصر الراكدة
  KPI_AUTO_SNAPSHOT       // التقاط لقطة KPI دورية
  CUSTOM                  // مهمة مخصصة
}

enum ScheduledJobStatus {
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
}

model ScheduledJob {
  id              String             @id @default(uuid())
  name            String             // اسم وصفي
  type            ScheduledJobType
  status          ScheduledJobStatus @default(ACTIVE)

  // التكرار: كل كم ساعة تُشغّل هذه المهمة
  intervalHours   Int                @default(24)

  // بيانات اختيارية يحتاجها نوع المهمة (مثلاً: معرف المشروع)
  payload         Json?

  // التتبع
  lastRunAt       DateTime?
  nextRunAt       DateTime
  lastResult      Json?
  lastError       String?
  runCount        Int                @default(0)

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status, nextRunAt])
  @@index([type])
}

// =============================================================
// الأدوات التحفيزية الأربع
// =============================================================

// ── 1. نظام الشارات ──────────────────────────────────────────
model EmployeeBadge {
  id          String    @id @default(uuid())
  userId      String
  badgeType   BadgeType
  periodLabel String?   // الفترة المرتبطة (YYYY-MM)
  note        String?   // ملاحظة اختيارية
  awardedAt   DateTime  @default(now())
  awardedById String?   // المدير الذي منح الشارة (null = تلقائي)

  user        User      @relation("BadgeUser",   fields: [userId],      references: [id], onDelete: Cascade)
  awarder     User?     @relation("BadgeAwarder", fields: [awardedById], references: [id])

  @@index([userId])
  @@index([badgeType])
  @@index([periodLabel])
}

// ── 2. بنك المبادرات ─────────────────────────────────────────
model ImprovementIdea {
  id           String     @id @default(uuid())
  userId       String
  title        String
  description  String
  category     String     @default("general") // process, technical, training, general
  status       IdeaStatus @default(PENDING)
  supportCount Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  reviewedAt   DateTime?
  reviewedById String?
  reviewNotes  String?
  implementedAt DateTime?

  user         User        @relation("IdeaAuthor",   fields: [userId],       references: [id], onDelete: Cascade)
  reviewer     User?       @relation("IdeaReviewer", fields: [reviewedById], references: [id])
  supporters   IdeaSupport[]

  @@index([userId])
  @@index([status])
}

model IdeaSupport {
  id        String   @id @default(uuid())
  ideaId    String
  userId    String
  createdAt DateTime @default(now())

  idea      ImprovementIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user      User            @relation("IdeaSupportUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ideaId, userId])
  @@index([ideaId])
}

// ── 3. التحدي الشهري للفريق ──────────────────────────────────
model TeamChallenge {
  id           String          @id @default(uuid())
  periodLabel  String          @unique
  title        String
  description  String?
  targetMetric String          // 'timeliness' | 'quality' | 'zero_returns' | 'all_before_ideal'
  targetValue  Float           // e.g., 90 = 90%
  status       ChallengeStatus @default(ACTIVE)
  result       Float?          // القيمة الفعلية عند الانتهاء
  achieved     Boolean         @default(false)
  createdById  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([periodLabel])
  @@index([status])
}

// ── 4. التعهد الشخصي الشهري ──────────────────────────────────
model MonthlyPledge {
  id           String    @id @default(uuid())
  userId       String
  periodLabel  String
  pledge1      String
  pledge2      String?
  pledge3      String?
  fulfilled1   Boolean?  // null = لم يُقيَّم بعد
  fulfilled2   Boolean?
  fulfilled3   Boolean?
  fulfillRate  Float?    // 0-100
  createdAt    DateTime  @default(now())
  evaluatedAt  DateTime?

  user         User      @relation("PledgeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodLabel])
  @@index([userId])
  @@index([periodLabel])
}

// =============================================================
// طبقة الإعدادات والمحتوى المُدار من قاعدة البيانات
// -------------------------------------------------------------
// لا شيء مكتوب بشكل ثابت في الكود: الترجمات + القوائم + الإعدادات
// =============================================================

// ── ترجمات الواجهة (قابلة للتحرير من لوحة الإدارة) ────────────
// مفتاح واحد لكل سلسلة (مثل "common.save") مع قيمته بكل لغة.
// ملفات JSON المجمّعة تبقى كبذرة/احتياطي إن تعذّر الوصول لقاعدة البيانات.
model Translation {
  id        String   @id @default(uuid())
  key       String   @unique          // مسار منقّط، مثل "nav.courses"
  ar        String                     // النص بالعربية
  en        String                     // النص بالإنجليزية
  category  String?                    // مساحة الاسم، مثل "common" أو "nav"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// ── قوائم الخيارات (المدن، أنواع الدورات، أنواع المواقع...) ────
model OptionItem {
  id        String   @id @default(uuid())
  category  String                     // "CITY" | "COURSE_TYPE" | "LOCATION_TYPE" | "COURSE_KIND" ...
  value     String                     // القيمة المخزّنة (مثل "external")
  labelAr   String
  labelEn   String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, value])
  @@index([category, isActive, sortOrder])
}

// ── إعدادات النظام (مفتاح/قيمة) ──────────────────────────────
// مثل عناوين بريد التقارير، بريد المُرسِل، بداية احتساب الأداء...
model AppSetting {
  key       String   @id              // مثل "report.email.to"
  value     String
  category  String?
  label     String?                    // وصف مقروء للوحة الإدارة
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([category])
}

// =============================================================
// توثيق الدورة — عنصر التميّز
// -------------------------------------------------------------
// اختياري في كل دورة: من وثّق دورته بالحد الأدنى من الجودة ونشرها
// نال «نجمة تميّز» ودرجات إضافية في مؤشره، ومن لم يوثّق لا يُخصم
// عليه شيء. وبيانات الدورة (اسمها وتواريخها ومكانها ومنسقها) تُقرأ
// من الدورة نفسها، فلا تُدخل مرتين.
// الصور تُحفظ في مخزن ملفات المنصة (lib/storage/mediaStore)، وهنا
// مراجعها وترتيبها وتعليقاتها.
// =============================================================
model CourseDocumentation {
  id            String    @id @default(uuid())
  courseId      String    @unique
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status        String    @default("DRAFT") // DRAFT | PUBLISHED
  slug          String?   @unique           // رابط المجلة العام (عشوائي لا يُخمَّن)
  intro         String?
  closing       String?
  coverMediaId  String?
  format        String    @default("A4") // A4 | SQUARE — مقاس المجلة
  welcome       String?   // كلمة ترحيب اختيارية في أول المجلة
  patronage     String?   // عبارة الإشراف أو الشراكة على الغلاف (اختيارية)
  logos         Json?     // شعارات الشركاء بجوار شعار الجامعة [{ preset } أو { key, name }]
  featured      Boolean   @default(false) // «إصدار مميّز» يمنحه المدير في مكتبة الإصدارات
  featuredAt    DateTime?
  sections      Json?     // الأقسام الظاهرة في المجلة والتقرير { gallery: false, … } — الغائب ظاهر
  publishedAt   DateTime?
  publishedById String?
  starAwarded   Boolean   @default(false)
  starAwardedAt DateTime?
  views         Int       @default(0)
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // التقرير الفني للقيادات وجهة التدريب
  reportSummary   String?
  recommendations String?

  media         DocumentationMedia[]
  sessions      DocumentationSession[]
  trainees      DocumentationTrainee[]

  @@index([status])
  @@index([status, publishedAt])
}

model DocumentationMedia {
  id              String              @id @default(uuid())
  documentationId String
  documentation   CourseDocumentation @relation(fields: [documentationId], references: [id], onDelete: Cascade)
  fileKey         String              // النسخة المعروضة (WebP حتى ٢٠٠٠ نقطة)
  thumbKey        String              // المصغّرة
  width           Int
  height          Int
  size            Int
  caption         String?
  // تعديل لا يمسّ الأصل: موضع التركيز والتقريب والفلتر (يُطبَّق عند العرض)
  edit            Json?
  sortOrder       Int                 @default(0)
  uploadedById    String?
  createdAt       DateTime            @default(now())

  @@index([documentationId, sortOrder])
}

model DocumentationSession {
  id              String              @id @default(uuid())
  documentationId String
  documentation   CourseDocumentation @relation(fields: [documentationId], references: [id], onDelete: Cascade)
  title           String
  presenter       String?
  date            DateTime?
  time            String?
  description     String?
  // صور الجلسة من صور التوثيق (حتى ٤) — تظهر معها في المجلة
  photoIds        String[]            @default([])
  sortOrder       Int                 @default(0)

  @@index([documentationId, sortOrder])
}

// متدربو الدورة في التقرير الفني: صورهم ودرجاتهم وما تميّزوا به.
// لا تظهر في المجلة العامة — التقرير يُستخرج من داخل المنصة وحدها.
model DocumentationTrainee {
  id              String              @id @default(uuid())
  documentationId String
  documentation   CourseDocumentation @relation(fields: [documentationId], references: [id], onDelete: Cascade)
  name            String
  entity          String?             // جهة المتدرب أو دولته
  score           Float?
  distinction     String?             // بماذا تميّز
  isDistinguished Boolean             @default(false)
  photoKey        String?
  sortOrder       Int                 @default(0)

  @@index([documentationId, sortOrder])
}
